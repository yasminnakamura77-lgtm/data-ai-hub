# Copy this file to `.env` and fill in the values, then restart the backend.
SNOWFLAKE_ACCOUNT=JBSUSA-PROD
SNOWFLAKE_USER=your.username@jbssa.com
SNOWFLAKE_WAREHOUSE=WH_PILGRIMS
# Sign in through the browser with your normal JBS account. The first query
# opens a Microsoft sign-in window; after that the login is remembered.
SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Optional. Points "Ask AI" on the catalogue pages at the data team's AI
# assistant (a separate prototype). Leave unset to see a placeholder answer.
# AI_ASSISTANT_URL=http://localhost:8100/ask
